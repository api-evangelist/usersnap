            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all feedbacks of the given project"
        },
        {
