                          "raw": "{\n  \"api_key\": \"<string>\",\n  \"visitor\": \"<string>\",\n  \"comment\": \"<string>\",\n  \"assignee\": \"<string>\",\n  \"client\": {\n    \"url\": \"<string>\",\n    \"screen_width\": \"<integer>\",\n    \"screen_height\": \"<integer>\"\n  },\n  \"rating\": \"<integer>\",\n  \"attachments\": [\n    {\n      \"content\": \"<string>\",\n      \"filename\": \"<string>\",\n      \"mime_type\": \"<string>\"\n    },\n    {\n      \"content\": \"<string>\",\n      \"filename\": \"<string>\",\n      \"mime_type\": \"<string>\"\n    }\n  ]\n}",
